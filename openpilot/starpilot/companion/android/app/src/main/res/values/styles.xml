<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#9d72ff</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:windowBackground">#070712</item>
        <item name="android:navigationBarColor">#070712</item><item name="android:statusBarColor">#070712</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <!-- Galaxy surface instead of the stock grey Material dialog. -->
    <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorBackground">#110E1F</item><item name="android:colorAccent">#9d72ff</item>
        <item name="android:textColorPrimary">#F3F2F8</item><item name="android:textColorSecondary">#9D9BB8</item>
        <item name="android:textColorHint">#8C9D9BB8</item><item name="android:colorControlNormal">#9D9BB8</item>
        <item name="android:colorControlActivated">#9d72ff</item><item name="android:colorControlHighlight">#3C9D72FF</item>
    </style>
</resources>
